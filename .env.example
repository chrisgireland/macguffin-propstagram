# Copy this file to .env.local and fill in your values.

# Cloudflare Worker API URL (see CLOUDFLARE-SETUP.md for how to deploy it).
VITE_API_URL=https://propstagram-api.your-subdomain.workers.dev

# Login (username + password) is now configured on the Worker, not here — see
# "wrangler secret put LOGINS" in CLOUDFLARE-SETUP.md. This file has nothing to
# set for that; if the Worker has no LOGINS secret, the app has no login and
# everyone has full access, same as before.
